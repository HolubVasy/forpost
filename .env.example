# ForPost environment configuration
# Copy this file to .env and fill in real values. Never commit .env.

# API key for authenticating requests to ForPost (read-only / whitelist mode)
API_KEY=

# GitHub tokens, scoped by mode (see the privilege model):
#  - GITHUB_TOKEN: personal token, exposed only in FULL-ACCESS (full rights on
#    your own repos: repo create, push, gh).
#  - GITHUB_WORK_TOKEN: work token, exposed only in WHITELIST (read commands
#    only), so ForPost can read work PRs but can never write to the work repo.
GITHUB_TOKEN=
GITHUB_WORK_TOKEN=

# Optional Google-OAuth for the MCP connector (in addition to X-API-Key).
# When OAUTH_ENABLED=true, /mcp also accepts a Google bearer token whose
# audience == OAUTH_CLIENT_ID and whose verified email is allow-listed.
# PUBLIC_URL is the externally-reachable base (for the OAuth metadata).
OAUTH_ENABLED=false
OAUTH_CLIENT_ID=
OAUTH_ALLOWED_EMAILS=
PUBLIC_URL=https://forpost.poly-mind.net

# When true, /mcp accepts ONLY a Google-OIDC bearer - the static X-API-Key is
# rejected there (it still guards REST). A leaked key then can't drive the MCP
# tunnel; only an allow-listed Google account can. Needs OAUTH_ENABLED=true.
MCP_REQUIRE_OAUTH=false

# User that read-only/whitelist commands run as (privilege separation). Set by
# the container image to `forpost-ro`; leave empty for local dev (runs in-process).
RESTRICTED_COMMAND_USER=

# Port ForPost listens on inside the container
PORT=8000

# Requests-per-minute rate limit (runaway-loop guard). Default 120.
# Applies to actions (execute, run_async, write); queries (read/job_status/
# job_kill) are exempt. nginx limit_req is the real flood gate.
RATE_LIMIT_PER_MINUTE=120

# Hard ceiling for a per-call command timeout, in seconds. The request's
# `timeout` (default 300) is clamped to this. Default 1800 (30 min).
MAX_TIMEOUT_SECONDS=1800

# Max chars of stdout/stderr returned and logged (tail kept). Default 100000.
# Also caps a single read_file slice.
MAX_OUTPUT_CHARS=100000

# Background jobs: max running at once, per-job log size cap, and how long a
# finished job (and its log) is kept before it's reaped.
MAX_CONCURRENT_JOBS=5
MAX_JOB_LOG_BYTES=52428800
JOB_RETENTION_SECONDS=3600

# Log budget per file (commands.jsonl, app.log). When commands.jsonl exceeds
# MAX_LOG_BYTES, the oldest LOG_TRIM_FRACTION of lines are dropped; app.log
# rotates (keeps one .1 backup).
MAX_LOG_BYTES=10485760
LOG_TRIM_FRACTION=0.2
