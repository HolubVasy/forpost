# Copy to .builder.env on the VPS (git-ignored). For the sandboxed Claude Code
# builder (docker-compose.builder.yml). NOT the same file as ForPost's .env.

# Claude subscription OAuth token - no Anthropic API key, no per-token billing.
# Mint it ONCE on your own machine (browser login happens there, not on the VPS):
#   claude setup-token
# Paste the printed token here. Valid ~1 year; regenerate before expiry.
CLAUDE_CODE_OAUTH_TOKEN=

# Personal GitHub token so the builder can clone + create repos + push + PR.
# NEVER put the work token here - the builder must not touch work repos.
GITHUB_TOKEN=

# Safety cap: max autonomous turns per task (default 40).
CLAUDE_MAX_TURNS=40

# Auto-clean: task workspaces older than this many days are pruned on each run.
TASK_RETENTION_DAYS=2
